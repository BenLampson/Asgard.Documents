{
  "name": "asgard-documents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/generate-assets.mjs && next build",
    "start": "node scripts/serve-preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-export.mjs",
    "test:browser": "playwright test",
    "preview": "node scripts/serve-preview.mjs",
    "format": "prettier --write app components lib scripts tests *.ts *.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.17.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
