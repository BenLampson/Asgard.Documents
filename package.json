{
  "name": "asgard-documentation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "worker:check": "node scripts/check-worker-build.mjs",
    "static:export": "node scripts/export-static-site.mjs",
    "static:check": "node scripts/check-static-export.mjs",
    "build:cdn": "npm run build && npm run static:export",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config dist/server/wrangler.json",
    "test": "npm run docs:check && node --test tests/rendered-html.test.mjs tests/document-search.test.mjs tests/skills-artifacts.test.mjs tests/agent-workflow-coverage.test.mjs tests/changelog-review.test.mjs tests/release-documentation-plan.test.mjs tests/release-readiness.test.mjs tests/source-project-coverage.test.mjs tests/static-artifact.test.mjs tests/static-rollback.test.mjs",
    "docs:check": "node scripts/check-docs-freshness.mjs && node scripts/check-source-project-coverage.mjs",
    "docs:check:live": "node scripts/check-docs-freshness.mjs --strict-source --check-nuget && node scripts/check-source-project-coverage.mjs",
    "links:check": "node scripts/check-rendered-links.mjs",
    "links:external:offline": "node scripts/check-external-links.mjs --offline",
    "links:external": "node scripts/check-external-links.mjs --live",
    "links:external:strict": "node scripts/check-external-links.mjs --live --strict",
    "verify": "npm run docs:check:live && npm run build:cdn && npm run worker:check && npm run lint && npm test && npm run links:check && npm run static:check && npm run links:external:offline",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "mermaid": "^11.16.0",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "type": "module"
}
